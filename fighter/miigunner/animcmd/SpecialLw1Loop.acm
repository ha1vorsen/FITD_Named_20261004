MoveDef SpecialLw1Loop
{
	Main()
	{
		Remove_All_Hitboxes()
		Script_End()
	}

	Effect()
	{
		FRAME(Frames=1)
		Terminate_Graphic_Effect(Graphic=0x3020013, unknown=0x1, unknown=0x1)
		Terminate_Graphic_Effect(Graphic=0x3020011, unknown=0x1, unknown=0x1)
		External_Graphic_Effect2(Graphic=0x3020013, Bone=0x1A, X=0, Y=0, Z=0, XRot=0, YRot=0, ZRot=0, Size=1.5, Terminate=0x1)
		External_Graphic_Effect2(Graphic=0x3020011, Bone=0x1A, X=0, Y=0, Z=0, XRot=0, YRot=0, ZRot=0, Size=1.5, Terminate=0x1)
		Set_Loop(Iterations=-1){
		    Color_Overlay(Red=255, Green=200, Blue=200, Alpha=96)
		    WAIT(Frames=2)
		    Terminate_Overlays()
		    WAIT(Frames=1)
		    Goto(Offset=-10)
		}
		Script_End()
	}

	Sound()
	{
		FRAME(Frames=1)
		Transient_Sound_Effect(SFX=0x81C0030)
		Script_End()
	}

	Expression()
	{
		Item_Visibility(State=0x0)
		FRAME(Frames=1)
		FRAME(Frames=15)
		Loop_Rest()
		JUMP(Hash=0x23433F79)
		Script_End()
	}

}

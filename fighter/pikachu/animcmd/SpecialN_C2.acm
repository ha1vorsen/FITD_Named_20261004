		Set_Frame_Duration(Speed=1)
		Script_End()
	}

	Effect()
	{
		FRAME(Frames=17)
		Graphic_Effect3(Graphic=0x100000C, Bone=0x0, X=0, Y=0, Z=0, XRot=0, YRot=0, ZRot=0, Size=1, RandomX=0, RandomY=0, RandomZ=0, RandomXRot=0, RandomYRot=0, RandomZRot=0, Terminate=0x0)
		Set_Loop(Iterations=-1){
		    Color_Overlay(Red=0, Green=0, Blue=255, Alpha=50)

MoveDef SpecialHi_C2
{
	Main()
	{
		FRAME(Frames=10)
		Set_Frame_Duration(Speed=2)
		FRAME(Frames=24)
		Set_Frame_Duration(Speed=1)
		Script_End()
	}

	Effect()
	{
		FRAME(Frames=1)
		Set_Loop(Iterations=2){
		    Color_Overlay(Red=255, Green=255, Blue=255, Alpha=80)
		    WAIT(Frames=3)
		    Terminate_Overlays()
		    WAIT(Frames=2)
		    Goto(Offset=-10)
		}
		Script_End()
	}

	Sound()
	{
		FRAME(Frames=2)
		PLAY_SE_REMAIN(unknown=0x130075)
		Script_End()
	}

	Expression()
	{
	}

}

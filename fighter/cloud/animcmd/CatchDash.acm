MoveDef CatchDash
{
	Main()
	{
		FRAME(Frames=10)
		Extended_Grab_Collision(ID=0x0, Bone=0x0, Size=2.6, X=0, Y=6.6, Z=4, Action=0x3F, Ground/Air=0x3, X2=0, Y2=6.6, Z2=10.6)
		CALL(Hash=0x49FA5BDD)
		WAIT(Frames=2)
		Remove_All_Grab_Collisions()
		ON_FLAG(Variable=RA-Flag[13])
		Script_End()
	}

	Effect()
	{
		FRAME(Frames=9)
		Set_Loop(Iterations=2){
		    WAIT(Frames=5)
		    Graphic_Effect(Graphic=0x100001B, Bone=0x0, X=8, Y=0, Z=0, XRot=0, YRot=0, ZRot=0, Size=0.9, RandomX=0, RandomY=0, RandomZ=0, RandomXRot=0, RandomYRot=0, RandomZRot=0, Terminate=0x0)
		    Goto(Offset=-19)
		}
		Script_End()
	}

	Sound()
	{
		FRAME(Frames=6)
		Sound_Effect(SFX=0x6F)
		WAIT(Frames=9)
		Stop_Sound_Effect(SFX=0x6F)
		Script_End()
	}

	Expression()
	{
		Slope_Full(unknown=0x1, unknown=0x5)
		FRAME(Frames=4)
		Slope_Full(unknown=0x6, unknown=0x3)
		Script_End()
	}

}

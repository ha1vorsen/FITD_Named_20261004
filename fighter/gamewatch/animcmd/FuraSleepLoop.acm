MoveDef FuraSleepLoop
{
	Main()
	{
		Model_Changer(ChangerID=0x1, ChangerState=0x1)
		Float_Compare(Type=0x0, Method=0x5, Value=0)
		True(Offset=0x7){
		    Model_Changer(ChangerID=0x6, ChangerState=0xC)
		}
		Else(Offset=0x5){
		    Model_Changer(ChangerID=0x6, ChangerState=0x6)
		}
		WAIT(Frames=30)
		Float_Compare(Type=0x0, Method=0x5, Value=0)
		True(Offset=0x7){
		    Model_Changer(ChangerID=0x6, ChangerState=0xB)
		}
		Else(Offset=0x5){
		    Model_Changer(ChangerID=0x6, ChangerState=0x5)
		}
		WAIT(Frames=30)
		Float_Compare(Type=0x0, Method=0x5, Value=0)
		True(Offset=0x7){
		    Model_Changer(ChangerID=0x6, ChangerState=0xA)
		}
		Else(Offset=0x5){
		    Model_Changer(ChangerID=0x6, ChangerState=0x4)
		}
		WAIT(Frames=30)
		JUMP(Hash=0x33F4A4EB)
		Script_End()
	}

	Effect()
	{
		FRAME(Frames=25)
		External_Graphic_Effect2(Graphic=0x100002E, Bone=0x13, X=2, Y=4, Z=0, XRot=0, YRot=0, ZRot=0, Size=1, Terminate=0x0)
		Loop_Rest()
		JUMP(Hash=0x33F4A4EB)
		Script_End()
	}

	Sound()
	{
		Transient_Sound_Effect(SFX=0x6E10016)
		WAIT(Frames=1)
		Loop_Rest()
		JUMP(Hash=0x33F4A4EB)
		Script_End()
	}

	Expression()
	{
		SLOPE(unknown=0x1)
		WAIT(Frames=1)
		Loop_Rest()
		JUMP(Hash=0x33F4A4EB)
		Script_End()
	}

}

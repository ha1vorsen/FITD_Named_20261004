MoveDef SpecialHiHold
{
	Main()
	{
		FRAME(Frames=20)
		Set_Loop(Iterations=7){
		    Hitbox(ID=0x0, Part=0x0, Bone=0x0, Damage=2, Angle=0x46, KBG=0x28, WBKB=0x0, BKB=0x28, Size=6, X=0, Y=8, Z=0, Effect=0x5, Trip=0, Hitlag=1, SDI=1, Clang=0x0, Rebound=0x0, ShieldDamage=0x0, SFXLevel=0x1, SFX=0x8, Ground/Air=0x3, Direct/Indirect=0x1, Type=0x0)
		    WAIT(Frames=1)
		    Remove_All_Hitboxes()
		    WAIT(Frames=1)
		    Goto(Offset=-30)
		}
		Script_End()
	}

	Effect()
	{
		FRAME(Frames=1)
		External_Graphic(Graphic=0x3150007, Bone=0x0, X=0, Y=0, Z=0, XRot=0, YRot=0, ZRot=0, Size=0.9, Terminate=0x1)
		Set_Loop(Iterations=5){
		    Color_Overlay(Red=255, Green=255, Blue=255, Alpha=30)
		    WAIT(Frames=1)
		    Color_Overlay(Red=255, Green=128, Blue=0, Alpha=30)
		    WAIT(Frames=1)
		    Terminate_Overlays()
		    WAIT(Frames=1)
		    Goto(Offset=-17)
		}
		FRAME(Frames=11)
		Set_Loop(Iterations=5){
		    Color_Overlay(Red=255, Green=255, Blue=255, Alpha=100)
		    WAIT(Frames=1)
		    Color_Overlay(Red=255, Green=128, Blue=0, Alpha=100)
		    WAIT(Frames=1)
		    Terminate_Overlays()
		    WAIT(Frames=1)
		    Goto(Offset=-17)
		}
		Set_Loop(Iterations=-1){
		    Color_Overlay(Red=255, Green=255, Blue=255, Alpha=180)
		    WAIT(Frames=1)
		    Color_Overlay(Red=255, Green=128, Blue=0, Alpha=180)
		    WAIT(Frames=1)
		    Terminate_Overlays()
		    WAIT(Frames=1)
		    Goto(Offset=-17)
		}
		Script_End()
	}

	Sound()
	{

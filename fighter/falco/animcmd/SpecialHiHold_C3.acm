MoveDef SpecialHiHold_C3
{
	Main()
	{
		Set_Frame_Duration(Speed=1.25)
		FRAME(Frames=35)
		Set_Frame_Duration(Speed=1)
		Script_End()
	}

	Effect()
	{
		FRAME(Frames=1)
		External_Graphic(Graphic=0x3150007, Bone=0x0, X=0, Y=0, Z=0, XRot=0, YRot=0, ZRot=0, Size=1, Terminate=0x1)
		LAST_EFFECT_SET_RATE(unknown=0.9)
		Set_Loop(Iterations=5){
		    Color_Overlay(Red=255, Green=255, Blue=255, Alpha=30)
		    WAIT(Frames=1)
		    Color_Overlay(Red=255, Green=128, Blue=0, Alpha=30)
		    WAIT(Frames=1)
		    Terminate_Overlays()
		    WAIT(Frames=1)
		    Goto(Offset=-17)
		}
		FRAME(Frames=11)
		Set_Loop(Iterations=5){
		    Color_Overlay(Red=255, Green=255, Blue=255, Alpha=100)
		    WAIT(Frames=1)
		    Color_Overlay(Red=255, Green=128, Blue=0, Alpha=100)
		    WAIT(Frames=1)
		    Terminate_Overlays()
		    WAIT(Frames=1)
		    Goto(Offset=-17)
		}
		Set_Loop(Iterations=-1){
		    Color_Overlay(Red=255, Green=255, Blue=255, Alpha=180)
		    WAIT(Frames=1)
		    Color_Overlay(Red=255, Green=128, Blue=0, Alpha=180)
		    WAIT(Frames=1)
		    Terminate_Overlays()
		    WAIT(Frames=1)
		    Goto(Offset=-17)
		}
		Script_End()
	}

	Sound()
	{
		FRAME(Frames=2)
		Sound_Effect(SFX=0x180055)
		Script_End()
	}

	Expression()
	{
		SLOPE(unknown=0x6)
		Script_End()
	}

}

MoveDef SpecialHi_C3
{
	Main()
	{
		Set_Frame_Duration(Speed=2.5)
		FRAME(Frames=13)
		Set_Frame_Duration(Speed=1)
		ON_FLAG(Variable=RA-Flag[13])
		WAIT(Frames=1)
		ON_FLAG(Variable=RA-Flag[15])
		Grab_Collision2(ID=0x0, Bone=0x0, Size=5.5, X=0, Y=12, Z=7, Action=0xBD, Ground/Air=0x3, Unknown=0x1)
		Grab_Collision2(ID=0x1, Bone=0x0, Size=6.5, X=0, Y=8.8, Z=13.7, Action=0xBD, Ground/Air=0x1, Unknown=0x1)
		WAIT(Frames=1)
		Remove_Grab_Collision(ID=0x1)
		FRAME(Frames=19)
		Allow/Disallow_Ledgegrab(State=0x1)
		FRAME(Frames=31)
		Remove_All_Grab_Collisions()
		Remove_All_Hitboxes()
		FRAME(Frames=36)
		Allow/Disallow_Ledgegrab(State=0x2)
		FRAME(Frames=50)
		ON_FLAG(Variable=RA-Flag[18])
		Script_End()
	}

	Effect()
	{
		Graphic_Effect2(Graphic=0x1000008, Bone=0x0, X=0, Y=0, Z=0, XRot=0, YRot=0, ZRot=0, Size=1, RandomX=0, RandomY=0, RandomZ=0, RandomXRot=0, RandomYRot=0, RandomZRot=0, Terminate=0x0)
		External_Graphic(Graphic=0x30C0005, Bone=0x18, X=0, Y=0, Z=0, XRot=0, YRot=45, ZRot=0, Size=0.8, Terminate=0x1)
		Graphic_Effect3(Graphic=0x0, Bone=0x0, X=0, Y=0, Z=0, XRot=0, YRot=0, ZRot=0, Size=1, RandomX=0, RandomY=0, RandomZ=0, RandomXRot=0, RandomYRot=0, RandomZRot=0, Terminate=0x1)
		Set_Loop(Iterations=4){
		    Color_Overlay(Red=255, Green=255, Blue=100, Alpha=100)
		    WAIT(Frames=1)
		    Color_Overlay(Red=255, Green=100, Blue=0, Alpha=90)
		    WAIT(Frames=1)
		    Terminate_Overlays()
		    WAIT(Frames=1)
		    Goto(Offset=-17)
		}
		Set_Loop(Iterations=3){
		    Color_Overlay(Red=255, Green=255, Blue=100, Alpha=100)
		    WAIT(Frames=1)
		    Color_Overlay(Red=255, Green=100, Blue=0, Alpha=90)
		    WAIT(Frames=1)
		    Terminate_Overlays()
		    WAIT(Frames=1)
		    Goto(Offset=-17)
		}
		FRAME(Frames=30)
		Terminate_Graphic_Effect(Graphic=0x30C0005, unknown=0x0, unknown=0x1)
		Script_End()
	}

	Sound()
	{
		FRAME(Frames=2)
		Sound_Effect(SFX=0xE009C)
		WAIT(Frames=2)
		Sound_Effect(SFX=0xE007A)
		WAIT(Frames=10)
